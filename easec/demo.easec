note [ --- easec Feature Demonstration Script --- ]

note [ 1. Variables, Types, and Casting ]
say "--- 1. Variables & Type Casting ---"
var number intVar 100
var decimal floatVar 99.9
var boolean boolVar true
var string strVar "Hello easec!"

say intVar
say floatVar
say boolVar
say strVar

note This casts a decimal value to a standard integer (truncating it)
var number castedInt floatVar
say "Casted Float to Int:"
say castedInt


note [ 2. Arithmetic, Precedence, and Comparisons ]
say "--- 2. Arithmetic & Comparisons ---"
var number result 10 + 20 * 2
say "10 + 20 * 2 = " + result

if result >= 50 [
    say "Result is greater than or equal to 50"
] else [
    say "Result is less than 50"
]


note [ 3. Mutator Operations (Increment & Decrement) ]
say "--- 3. Increment & Decrement ---"
var number counter 10
increment counter 5
say "Counter after +5:"
say counter

decrement counter 3
say "Counter after -3:"
say counter


note [ 4. Repeat Loops & Break (Out) ]
say "--- 4. Repeat Loops ---"
say "Finite loop execution:"
var number loopLimit 3
repeat loopLimit [
    say "Iteration"
]

say "Infinite loop with a conditional break:"
var number breakCounter 0
repeat forever [
    increment breakCounter 1
    if breakCounter == 3 [
        say "Condition met. Breaking..."
        out
    ]
    say breakCounter
]


note [ 5. Functions (Jobs) ]
say "--- 5. Jobs ---"
job addNumbers valA valB [
    var number sum valA + valB
    out sum
]

var number jobSum addNumbers 12, 18
say "Sum via Job: " + jobSum


note [ 6. Arrays ]
say "--- 6. Arrays ---"
array number myArr 10, 20, 30
var number arrLen array length myArr
say "Array elements count:"
say arrLen

var number firstElement array get myArr, 0
say "Element at index 0: " + firstElement

array set myArr, 1, 99
var number updatedElement array get myArr, 1
say "Updated element at index 1: " + updatedElement


note [ 7. Dictionaries ]
say "--- 7. Dictionaries ---"
dictionary myDict name: "Alice", age: 30
var number dictSize dictionary length myDict
say "Dictionary elements count:"
say dictSize

var string dictName dictionary get key myDict, "name"
say "Value for key 'name': " + dictName

dictionary set key myDict, "age", 31
var number dictAge dictionary get key myDict, "age"
say "Updated value for key 'age': " + dictAge


note [ 8. File I/O Operations ]
say "--- 8. File Operations ---"
file create "sample.txt" [ "First line of sample text." ]
var string initialContent file read "sample.txt"
say "Read after creation:"
say initialContent

file update "sample.txt" [ " Appended content here." ]
var string finalContent file read "sample.txt"
say "Read after update:"
say finalContent

file delete "sample.txt"
say "sample.txt has been deleted."


note [ 9. Embedded Raw C Code Compilation and Execution ]
note Note: This step requires GCC to be installed and available in the system PATH.
say "--- 9. Embedded Raw C ---"
raw [
#include <stdio.h>
int main() {
    printf("Output directly from the embedded Raw C sandbox environment!\n");
    return 0;
}
]


note [ 10. Interactive User Input ]
note Uncomment the lines below to test manual console inputs.
note say "--- 10. Manual Console Input ---"
note say "Type something and hit enter:"
note var userInput get
note say "You entered: " + userInput