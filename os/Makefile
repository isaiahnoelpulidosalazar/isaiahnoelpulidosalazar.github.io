CC = gcc
AS = gcc

CFLAGS = -m32 -ffreestanding -O2 -Wall -Wextra -fno-exceptions -fno-pie -mno-sse -mno-sse2
ASFLAGS = -m32
LDFLAGS = -m32 -T linker.ld -ffreestanding -O2 -nostdlib -no-pie -Wl,-n

OBJS = boot.o kernel.o

all: inpsos.iso

embedded_files.h: easec/*.easec
	@echo "Generating embedded_files.h..."
	@echo "/* Auto-generated by Makefile */" > embedded_files.h
	@echo "typedef struct { const char* name; const char* code; } EmbeddedFile;" >> embedded_files.h
	@echo "EmbeddedFile embedded_files[] = {" >> embedded_files.h
	@for file in easec/*.easec; do \
		name=$$(basename $$file .easec); \
		echo -n "    {\"$$name\", \"" >> embedded_files.h; \
		cat $$file | sed 's/\\/\\\\/g' | sed 's/"/\\"/g' | awk '{printf "%s\\n", $$0}' | tr -d '\n' >> embedded_files.h; \
		echo "\"}," >> embedded_files.h; \
	done
	@echo "    {0, 0}" >> embedded_files.h
	@echo "};" >> embedded_files.h

boot.o: boot.s
	$(AS) $(ASFLAGS) -c $< -o $@

kernel.o: kernel.c embedded_files.h
	$(CC) $(CFLAGS) -c $< -o $@

inpsos.bin: $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $(OBJS)

inpsos.iso: inpsos.bin grub.cfg
	mkdir -p isodir/boot/grub
	cp inpsos.bin isodir/boot/inpsos.bin
	cp grub.cfg isodir/boot/grub/grub.cfg
	grub-mkrescue -o inpsos.iso isodir

clean:
	rm -f *.o inpsos.bin inpsos.iso embedded_files.h
	rm -rf isodir