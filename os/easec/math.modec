note [ math.modec - A simple math module demonstrating jobs and scoping ]

var decimal PI = 3.14159
var decimal E  = 2.71828

note [ Calculate the sum of two numbers ]
job add a, b [
    out a + b
]

note [ Calculate the product of two numbers ]
job multiply a, b [
    out a * b
]

note [ Recursive factorial function ]
job factorial n [
    if n <= 1 [
        out 1
    ] else [
        out n * factorial(n - 1)
    ]
]

note [ Recursive fibonacci sequence ]
job fibonacci n [
    if n <= 1 [
        out n
    ] else [
        out fibonacci(n - 1) + fibonacci(n - 2)
    ]
]