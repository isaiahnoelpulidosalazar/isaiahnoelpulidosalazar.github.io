note This is an AI created sample.

note [
  ====================================
  |        CHEASE v1.3.0 DEMO        |
  ====================================
  This file showcases the features of
  the Chease programming language!
]

say "================================="
say " Welcome to Chease v1.3.0 Demo!  "
say "================================="
say ""

note --- 1. Variables & Types ---
say ">>> 1. VARIABLES & TYPES"
var boolean isAwesome true
var number age 42
var decimal temp 98.6
var string name "Chester"
var untypedVar "I have no explicit type!"

say "Boolean: " + isAwesome
say "Number : " + age
say "Decimal: " + temp
say "String : " + name
say "Untyped: " + untypedVar
say ""


note --- 2. Math Operations & Increment/Decrement ---
say ">>> 2. MATH OPERATIONS"
var number a 15
var number b 4

var number sum a + b
var number diff a - b
var number prod a * b
var decimal div a / b
var number mod a % b

say "Given a=15, b=4"
say "Sum: " + sum
say "Diff: " + diff
say "Prod: " + prod
say "Div: " + div
say "Mod: " + mod

increment a 5
say "a after incrementing by 5: " + a
decrement b 1
say "b after decrementing by 1: " + b
say ""


note --- 3. Conditionals ---
say ">>> 3. CONDITIONALS"
if a > 15 [
    say "Condition met: a is strictly greater than 15"
] else [
    say "Condition not met: a is 15 or less"
]
say ""


note --- 4. Loops ---
say ">>> 4. LOOPS"
var number counter 1
say "Repeating 3 times using fixed count:"
repeat 3 [
    say " - Iteration " + counter
    increment counter 1
]

say "Repeating forever (with a break condition using 'out'):"
var number fCount 1
repeat forever [
    say " - Forever loop iteration " + fCount
    if fCount == 2 [
        say "   Breaking out of forever loop!"
        out
    ]
    increment fCount 1
]
say ""


note --- 5. Arrays ---
say ">>> 5. ARRAYS"
array number scores 10, 20, 30
say "Array length: " + array length scores
say "Element at index 0: " + array get scores, 0

array set scores, 1, 99
say "Element at index 1 after update: " + array get scores, 1
say ""


note --- 6. Dictionaries ---
say ">>> 6. DICTIONARIES"
dictionary player name: "Hero", hp: 100, level: 5
say "Player Dictionary length: " + dictionary length player
say "Player Name: " + dictionary get key player, "name"
say "Player HP: " + dictionary get key player, "hp"

dictionary set key player, "hp", 85
say "Player HP after taking damage: " + dictionary get key player, "hp"
say ""


note --- 7. Jobs (Functions) ---
say ">>> 7. JOBS (FUNCTIONS)"
job greet user [
    say "Hello there, " + user + "!"
]

job addNumbers x y [
    note 'out' with a value acts as a return statement 
    out x + y
]

greet "Chease Programmer"

var number result addNumbers 10, 25
say "Result of addNumbers 10, 25 is: " + result
say ""


note --- 8. File I/O ---
say ">>> 8. FILE I/O"
var string testFile "chease_test_log.txt"

say "Creating file " + testFile + "..."
file create testFile [ "Log started. " ]

say "Appending to file..."
file update testFile [ "All systems nominal." ]

say "Reading file content:"
var string fileContent file read testFile
say fileContent

say "Deleting file..."
file delete testFile
say "File operations completed successfully."
say ""

note --- 9. User Input (Commented out to run automatically) ---
note say "What is your name?"
note var string userName get
note say "Nice to meet you, " + userName + "!"

say "================================="
say " Demo completed successfully!    "
say "================================="