say "================================="
say " Executing Raw C# Code In-Memory "
say "================================="

raw [
    using System;
    
    internal class Program {
        private static void Main(string[] args) {
            Console.WriteLine("Hello, from raw memory execution!");
            Console.WriteLine("I calculated 5 * 5 = " + (5 * 5));
        }
    }
]

say ""
say "================================="
say " Compiling C# Code to an Exe     "
say "================================="

compile [
    using System;

    internal class Program {
        private static void Main(string[] args){
            Console.WriteLine("I am a standalone compiled executable generated by Chease!");
            Console.ReadLine();
        }
    }
]

say "End of Chease script."